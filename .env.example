# ChatFlow Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-chatflow-app.vercel.app
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_2026

# Database Configuration (Required for Vercel / Cloud Hosting)
# Sign up at https://mongodb.com/atlas to get a free MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatflow?retryWrites=true&w=majority

# Optional: Frontend API and Socket URLs (if client and server are hosted on separate domains)
# VITE_API_URL=https://your-chatflow-backend.onrender.com
# VITE_SOCKET_URL=https://your-chatflow-backend.onrender.com

# Media Storage Configuration (Cloudinary / Local)
# If omitted, ChatFlow securely uses local media storage (/uploads) with database tracking.
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# or
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

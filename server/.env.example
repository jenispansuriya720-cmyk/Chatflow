PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-production-app.vercel.app
JWT_SECRET=your_strong_production_jwt_secret_key_minimum_32_characters

# Production MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatflow?retryWrites=true&w=majority

# ==================================================
# REAL SMTP MAIL SERVER CONFIGURATION
# Configure these in your hosting dashboard (Vercel / Render / Railway)
# ==================================================

# SMTP Host & Port Options:
# Standard STARTTLS (Recommended):
#   SMTP_HOST=smtp.gmail.com (or smtp-relay.brevo.com / smtp.sendgrid.net)
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Direct SSL (Alternative):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication:
# IMPORTANT: Do NOT wrap credentials in quotation marks!
# For Gmail: Use an App Password (16 characters, 2-Step Verification enabled)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password_without_quotes

# Sender Identity:
# IMPORTANT: Most providers (Gmail, Brevo, SendGrid) require FROM_EMAIL to match SMTP_USER or a verified domain.
FROM_EMAIL=your-email@gmail.com
FROM_NAME=ChatFlow

# Optional Advanced Cloud Tweaks:
# SMTP_SERVICE=gmail
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_CONNECTION_TIMEOUT=15000
